{
  "name": "cakbro-safe-exam-browser",
  "version": "2.0.0",
  "description": "CakBro Safe Exam Browser v2.0 - Portable & Lightweight Kiosk Browser untuk ujian aman. Cross-platform: Windows, Linux, macOS, Chromebook",
  "main": "main.js",
  "author": {
    "name": "Pakkar",
    "email": "support@pakkar.my.id"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --ia32",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --linux --mac",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "id.my.pakkar.cakbro",
    "productName": "CakBro",
    "copyright": "Copyright \u00a9 2026 Pakkar",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraMetadata": {
      "main": "main.js"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "CakBro-${version}-${arch}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CakBro Safe Exam Browser",
      "include": "assets/installer.nsh"
    },
    "portable": {
      "artifactName": "CakBro-${version}-Portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Education",
      "artifactName": "CakBro-${version}-${arch}.${ext}",
      "executableName": "cakbro",
      "maintainer": "Pakkar <support@pakkar.my.id>",
      "synopsis": "CakBro Safe Exam Browser"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education",
      "artifactName": "CakBro-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false,
      "title": "CakBro Safe Exam Browser v${version}",
      "iconSize": 128
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.9.0"
  }
}